; THE LAST MOVE - Godot 4.6.3 project
; Engine configuration file.
config_version=5

[application]

config/name="THE LAST MOVE"
config/description="Cooperative physics comedy about a moving company that relocates people out of houses that fight back."
config/version="1.0.0"
run/main_scene="res://scenes/core/root.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/icons/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.05, 0.06, 1)

[audio]

driver/enable_input=true

[autoload]

Settings="*res://scripts/core/settings_manager.gd"
DB="*res://scripts/core/db.gd"
Save="*res://scripts/core/save_manager.gd"
Audio="*res://scripts/core/audio_manager.gd"
Net="*res://scripts/core/net.gd"
Game="*res://scripts/core/game.gd"

[debug]

gdscript/warnings/inferred_declaration=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_multichannel_signed_distance_field=true

[physics]

3d/default_gravity=14.0
3d/default_linear_damp=0.05
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.03, 0.035, 0.05, 1)
occlusion_culling/use_occlusion_culling=true
textures/default_filters/anisotropic_filtering_level=2

[threading]

worker_pool/max_threads=2
